[Unit]
Description=SyncLight agent (app control for the ambient light box)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/synclight
Environment=PYTHONPATH=/opt/synclight
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m synclight_agent --config /etc/synclight/config.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
